# Server-only Gemini credentials. Never prefix this variable with VITE_.
GEMINI_API_KEY="your-server-side-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Public Supabase project settings (safe to expose when database RLS is enabled).
# Configure Google OAuth and the email OTP template in the Supabase dashboard.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional: the port used by the production Express server.
PORT=3000
